{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "core/src/**/*.ts",
    "core/test/**/*.ts",
    "core/bench/**/*.ts",
    "core/bench/**/*.d.ts",
    "react/src/**/*.ts",
    "react/src/**/*.tsx",
    "react/test/**/*.ts",
    "react/test/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
