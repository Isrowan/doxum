{
  "name": "@doxa/core",
  "version": "0.1.2",
  "private": false,
  "license": "MIT",
  "description": "Framework-neutral typed runtime for complex mutable documents.",
  "type": "module",
  "keywords": [
    "document",
    "state",
    "runtime",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealRong/Doxa.git",
    "directory": "core"
  },
  "homepage": "https://github.com/RealRong/Doxa#readme",
  "bugs": {
    "url": "https://github.com/RealRong/Doxa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js",
      "require": "./dist/integration.cjs"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "profile": "node --expose-gc --import tsx bench/profile.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false
}
