{
  "name": "doxum",
  "version": "0.1.5",
  "private": false,
  "license": "MIT",
  "description": "Doxum is a typed runtime for complex mutable documents.",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "keywords": [
    "document",
    "state",
    "runtime",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Isrowan/doxum.git"
  },
  "homepage": "https://github.com/Isrowan/doxum#readme",
  "bugs": {
    "url": "https://github.com/Isrowan/doxum/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js",
      "require": "./dist/integration.cjs"
    },
    "./local-sync": {
      "types": "./dist/local-sync.d.ts",
      "import": "./dist/local-sync.js",
      "require": "./dist/local-sync.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "profile": "node --expose-gc --import tsx core/bench/profile.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "clean": "pnpm -r exec rimraf dist",
    "release": "node scripts/release.mjs",
    "release:resume": "node scripts/release.mjs --resume"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-test-renderer": "19.2.4",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.0.16"
  }
}
