{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@doxa/core": ["./core/src/index.ts"],
      "@doxa/core/integration": ["./core/src/integration.ts"]
    }
  }
}
